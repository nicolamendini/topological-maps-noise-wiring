# Track only source-like files in the repository root plus helper modules.
*
!*/

!/.gitignore
!/README.md
!/AGENTS.md
!/*.py
!/*.ipynb

!/helpers/
!/helpers/*.py

# Generated outputs, datasets, and exploratory side projects.
/audio/**
/data_l3/**
/data_l4/**
/figures/**
/logs/**
/parameter_search_data/**
/run_status/**

/input_stimuli/**
/input_stimuli_*/**
/input_stimuli_triangle/**
/imagenet-mini/**
/imagenet_mini/**
/brain_observatory_cache/**
/path/**

# Python/Jupyter/runtime noise.
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Large or transient tensors/checkpoints.
*.pt
*.pth
*.ckpt
*.lprof
